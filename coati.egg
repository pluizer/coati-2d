(
(author "Richard van Roy")
(synopsis "A simple, small and fast 2D game programming library for Chicken Scheme.")
(license "MIT")
(category graphics)
(dependencies symbol-utils srfi-1 srfi-4 srfi-18 srfi-128 srfi-113 sdl2 sdl2-ttf gl-utils gl-math soil matchable ssax nrepl vector-lib queues)
(component-options (csc-options "-c++" "-C" "-Wno-pointer-arith -Wno-write-strings -Wno-narrowing -Wno-int-to-pointer-cast" "-I./src/deps/chipmunk/include" "-I./src"))
(components
 ;; Chipmunk
 (c-object chipmunkc        (source "src/deps/chipmunk/chipmunk.c"))
 (c-object cpArbiter        (source "src/deps/chipmunk/cpArbiter.c"))
 (c-object cpArray          (source "src/deps/chipmunk/cpArray.c"))
 (c-object cpBB             (source "src/deps/chipmunk/cpBB.c"))
 (c-object cpBBTree         (source "src/deps/chipmunk/cpBBTree.c"))
 (c-object cpBody           (source "src/deps/chipmunk/cpBody.c"))
 (c-object cpCollision      (source "src/deps/chipmunk/cpCollision.c"))
 (c-object cpHashSet        (source "src/deps/chipmunk/cpHashSet.c"))
 (c-object cpPolyShape      (source "src/deps/chipmunk/cpPolyShape.c"))
 (c-object cpShape          (source "src/deps/chipmunk/cpShape.c"))
 (c-object cpSpace          (source "src/deps/chipmunk/cpSpace.c"))
 (c-object cpSpaceComponent (source "src/deps/chipmunk/cpSpaceComponent.c"))
 (c-object cpSpaceHash      (source "src/deps/chipmunk/cpSpaceHash.c"))
 (c-object cpSpaceQuery     (source "src/deps/chipmunk/cpSpaceQuery.c"))
 (c-object cpSpaceStep      (source "src/deps/chipmunk/cpSpaceStep.c"))
 (c-object cpSpatialIndex   (source "src/deps/chipmunk/cpSpatialIndex.c"))
 (c-object cpSweep1D        (source "src/deps/chipmunk/cpSweep1D.c"))
 (c-object cpVect                (source "src/deps/chipmunk/cpVect.c"))
 (c-object cpConstraint          (source "src/deps/chipmunk/constraints/cpConstraint.c"))
 (c-object cpDampedRotarySpring  (source "src/deps/chipmunk/constraints/cpDampedRotarySpring.c"))
 (c-object cpDampedSpring        (source "src/deps/chipmunk/constraints/cpDampedSpring.c"))
 (c-object cpGearJoint           (source "src/deps/chipmunk/constraints/cpGearJoint.c"))
 (c-object cpGrooveJoint         (source "src/deps/chipmunk/constraints/cpGrooveJoint.c"))
 (c-object cpPinJoint            (source "src/deps/chipmunk/constraints/cpPinJoint.c"))
 (c-object cpPivotJoint          (source "src/deps/chipmunk/constraints/cpPivotJoint.c"))
 (c-object cpRatchetJoint        (source "src/deps/chipmunk/constraints/cpRatchetJoint.c"))
 (c-object cpRotaryLimitJoint    (source "src/deps/chipmunk/constraints/cpRotaryLimitJoint.c"))
 (c-object cpSimpleMotor         (source "src/deps/chipmunk/constraints/cpSimpleMotor.c"))
 (c-object cpSlideJoint          (source "src/deps/chipmunk/constraints/cpSlideJoint.c"))
 ;;
 (c-object algorithms	   (source "src/algorithms.scm"))
 (c-object animators       (source "src/animators.scm"))
 (c-object batcher         (source "src/batcher.scm"))
 (c-object blend           (source "src/blend.scm"))
 (c-object camera          (source "src/camera.scm"))
 (c-object chipmunk        (source "src/chipmunk.scm"))
 (c-object chunk           (source "src/chunk.scm"))
 (c-object drawing         (source "src/drawing.scm"))
 (c-object events          (source "src/events.scm"))
 (c-object font            (source "src/font.scm"))
 (c-object gamemap         (source "src/gamemap.scm"))
 (c-object input           (source "src/input.scm"))
 (c-object misc            (source "src/misc.scm"))
 (c-object node-pers       (source "src/node-pers.scm"))
 (c-object node            (source "src/node.scm"))
 (c-object particles       (source "src/particles.scm"))
 (c-object pathfinding     (source "src/pathfinding.scm"))
 (c-object physics         (source "src/physics.scm"))
 (c-object pixmap          (source "src/pixmap.scm"))
 (c-object polygon-batcher (source "src/polygon-batcher.scm"))
 (c-object primitives      (source "src/primitives.scm"))
 (c-object shader          (source "src/shader.scm"))
 (c-object sound           (source "src/sound.scm"))
 (c-object sprite-batcher  (source "src/sprite-batcher.scm"))
 (c-object sprite          (source "src/sprite.scm"))
 (c-object sprite-map      (source "src/sprite-map.scm"))
 (c-object static-tilemap  (source "src/static-tilemap.scm"))
 (c-object textbuffer      (source "src/textbuffer.scm"))
 (c-object texture         (source "src/texture.scm"))
 (c-object tilemap         (source "src/tilemap.scm"))
 (c-object triangulate     (source "src/triangulate.cc"))
 (c-object trans           (source "src/trans.scm"))
 (c-object window          (source "src/window.scm"))

 (program coati
          (source "src/coati-main.scm")
          (link-options "-L" "-lSDL2_mixer")
          (objects
	   chipmunkc
           cpArbiter
           cpArray
           cpBB
           cpBBTree
           cpBody
           cpCollision
           cpHashSet
           cpPolyShape
           cpShape
           cpSpace
           cpSpaceComponent
           cpSpaceHash
           cpSpaceQuery
           cpSpaceStep
           cpSpatialIndex
           cpSweep1D
           cpVect
           cpConstraint
           cpDampedRotarySpring
           cpDampedSpring
           cpGearJoint
           cpGrooveJoint
           cpPinJoint
           cpPivotJoint
           cpRatchetJoint
           cpRotaryLimitJoint
           cpSimpleMotor
           cpSlideJoint
	   algorithms
           animators
           batcher
           blend
           camera
	   chipmunk
           chunk
           drawing
           events
           font
	   gamemap
           input
           misc
           node-pers
           node
           particles
           pathfinding
	   physics
           pixmap
           polygon-batcher
           primitives
           shader
           sound
           sprite-batcher
           sprite
           sprite-map
	   static-tilemap
	   textbuffer
           texture
           tilemap
           triangulate
           trans
           window))

 (extension coati
            (source "src/coati.scm")
            (link-options "-L" "-lSDL2_mixer")
            (objects
	     ;; Chipmunk
	     chipmunkc
             cpArbiter
             cpArray
             cpBB
             cpBBTree
             cpBody
             cpCollision
             cpHashSet
             cpPolyShape
             cpShape
             cpSpace
             cpSpaceComponent
             cpSpaceHash
             cpSpaceQuery
             cpSpaceStep
             cpSpatialIndex
             cpSweep1D
             cpVect
             cpConstraint
             cpDampedRotarySpring
             cpDampedSpring
             cpGearJoint
             cpGrooveJoint
             cpPinJoint
             cpPivotJoint
             cpRatchetJoint
             cpRotaryLimitJoint
             cpSimpleMotor
             cpSlideJoint
	     ;;
	     algorithms
             animators
             batcher
             blend
             camera
	     chipmunk
             chunk
             drawing
             events
             font
	     gamemap
             input
             misc
             node-pers
             node
             particles
             pathfinding
	     physics
             pixmap
             polygon-batcher
             primitives
             shader
             sound
             sprite-batcher
             sprite
             sprite-map
	     static-tilemap
	     textbuffer
             texture
             tilemap
             triangulate
             trans
             window))
))
